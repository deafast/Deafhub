diff --git a/scripts/fc-capacity-sql-check.mjs b/scripts/fc-capacity-sql-check.mjs
new file mode 100644
index 0000000..dd44073
--- /dev/null
+++ b/scripts/fc-capacity-sql-check.mjs
@@ -0,0 +1,20 @@
+// Generates rollback-only legacy schema fixtures; never creates actual FC registrations.
+import {createTournament} from '../lib/tournament/engine.ts';
+const uid=n=>`10000000-0000-4000-8000-${String(n).padStart(12,'0')}`;
+const actor=uid(1),json=v=>`'${JSON.stringify(v).replaceAll("'","''")}'::jsonb`;
+let sql=`begin;\ninsert into auth.users(id,email,aud,role) values('${actor}','fc-capacity-rollback@deafhub-test.invalid','authenticated','authenticated');\ninsert into public.profiles(id,nickname,region) values('${actor}','Capacity rollback QA','europe');\ninsert into public.hub_organizers values('${actor}');\n`;
+for(let i=0;i<101;i++)sql+=`insert into public.hub_teams(id,name,game,captain_id) values('${uid(1000+i)}','Rollback capacity ${i}','fc','${actor}');\n`;
+for(const [index,count,game,success]of [[0,100,'fc',true],[1,101,'fc',false],[2,65,'cs2',false],[3,64,'cs2',true]]){
+ const tid=uid(2000+index),entries=Array.from({length:count},(_,i)=>uid(3000+index*200+i));
+ sql+=`insert into public.hub_tournaments(id,title,game,organizer_id,starts_at,rules,roster_size) values('${tid}','Rollback capacity ${count} ${game}','${game}','${actor}',now()+interval '1 day','Rollback-only capacity validation, not a real tournament',${game==='fc'?1:5});\n`;
+ for(let i=0;i<count;i++)sql+=`insert into public.hub_entries(id,tournament_id,team_id,status,rules_version) select '${entries[i]}',id,'${uid(1000+i)}','approved',rules_version from public.hub_tournaments where id='${tid}';\n`;
+ const config={format:'double',grandFinal:'reset',bestOf:1,groups:[],qualify:2,points:{win:3,draw:1,loss:0}};
+ let state=createTournament(game==='cs2'&&count>64?'fc':game,entries.slice(0,100),config);state.game=game;state.entries=entries;state.matches=[]; // Only SQL entrant ceiling is under test; engine graphs are tested separately.
+ const command=json({type:'launch'}),value=json(state),request=uid(5000+index);
+ sql+=`do $$declare r jsonb;begin\nperform set_config('request.jwt.claim.sub','${actor}',true);\nperform public.hub_ops_action('set_policy',jsonb_build_object('tournament_id','${tid}','body','Rollback-only capacity policy, no real participants','require_acceptance',false,'bronze','none'));\n`;
+ const call=`public.hub_engine_commit('${tid}','${actor}',0,'${request}',${command},${value})`;
+ if(success){sql+=`r:=${call};if r->>'revision'<>'1' then raise exception 'FAIL capacity revision';end if;\nr:=${call};if r->>'revision'<>'1' then raise exception 'FAIL duplicate revision';end if;\nbegin perform public.hub_engine_commit('${tid}','${actor}',999,gen_random_uuid(),'{"type":"result"}',${value});raise exception 'FAIL stale revision accepted';exception when raise_exception then if SQLERRM<>'Revision conflict' then raise;end if;end;\n`;}else{sql+=`begin perform ${call};raise exception 'FAIL capacity accepted';exception when raise_exception then if SQLERRM<>'Approved entries changed' then raise;end if;end;\n`;}
+ sql+='end $$;\n';
+}
+sql+=`do $$begin if has_function_privilege('anon','public.hub_engine_commit(uuid,uuid,integer,uuid,jsonb,jsonb)','execute') or has_function_privilege('authenticated','public.hub_engine_commit(uuid,uuid,integer,uuid,jsonb,jsonb)','execute') or not has_function_privilege('service_role','public.hub_engine_commit(uuid,uuid,integer,uuid,jsonb,jsonb)','execute') then raise exception 'FAIL RPC permissions';end if;end $$;\nrollback;\nselect 'FC100 pass; FC101 reject; CS65 reject; CS64 pass; replay/CAS/ACL pass; fixtures rolled back' as capacity_qa;`;
+console.log(sql);
diff --git a/supabase/migrations/20261019130440_fc_capacity_100.sql b/supabase/migrations/20261019130440_fc_capacity_100.sql
new file mode 100644
index 0000000..76b98c3
--- /dev/null
+++ b/supabase/migrations/20261019130440_fc_capacity_100.sql
@@ -0,0 +1,11 @@
+-- Only the participant ceiling changes. Preserve the current RPC body, ownership,
+-- locking, audit, idempotency, grants and participation/award triggers.
+do $migration$
+declare definition text; old_guard text:='n<2 or n>64 or ids'; new_guard text:='n<2 or n>(case when t.game=''fc'' then 100 else 64 end) or ids';
+begin
+ definition:=pg_get_functiondef('public.hub_engine_commit(uuid,uuid,integer,uuid,jsonb,jsonb)'::regprocedure);
+ if position(new_guard in definition)>0 then return;end if;
+ if (length(definition)-length(replace(definition,old_guard,'')))/length(old_guard)<>1 then raise exception 'Unexpected hub_engine_commit capacity guard; review migration';end if;
+ execute replace(definition,old_guard,new_guard);
+end $migration$;
+notify pgrst,'reload schema';
